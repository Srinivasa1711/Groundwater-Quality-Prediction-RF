<span class="n">precision</span><span class="p">[</span><span class="s2">"micro"</span><span class="p">],</span> <span class="n">recall</span><span class="p">[</span><span class="s2">"micro"</span><span class="p">],</span> <span class="n">_</span> <span class="o">=</span> <span class="n">precision_recall_curve</span><span class="p">(</span>
